# Copy to .env and adjust:  cp .env.example .env
#
# docker compose reads a sibling .env automatically, so every value below is
# picked up with no extra flags. Each is written as ${VAR:-default} in
# docker-compose.yml, which means the stack still starts with no .env at all —
# configurable, but a demo that runs first try.
#
# .env is gitignored and dockerignored. Never commit it, never COPY it into an image.

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobs

# The app's connection string. In production this comes from the platform:
# on App Platform it is bound as ${jobs-db.DATABASE_URL} in the app spec, and
# arrives as postgresql://...?sslmode=require — config.py normalises the scheme
# and strips sslmode for asyncpg.
DATABASE_URL=postgresql://postgres:postgres@db:5432/jobs
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Runtime ────────────────────────────────────────────────────────────────
ENV=local                 # local | staging | production — also selects log rendering
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
PORT=8000                 # App Platform injects this; don't hardcode it in code

# ─── Worker / orchestration ─────────────────────────────────────────────────
WORKER_ENABLED=true       # false on API-only replicas when workers are split out
WORKER_CONCURRENCY=4
WORKER_BATCH_SIZE=5
WORKER_POLL_INTERVAL_S=1.0

LEASE_SECONDS=30          # must exceed the slowest job, or healthy work gets reaped
HEARTBEAT_INTERVAL_S=10.0 # comfortably under LEASE_SECONDS
REAPER_INTERVAL_S=15.0

MAX_ATTEMPTS=4
BACKOFF_BASE_S=2.0
BACKOFF_MAX_S=60.0

# ─── Simulated downstream dependency ────────────────────────────────────────
# Set to 0 for a deterministic demo; raise it to show retry and dead-lettering.
DEPENDENCY_FAILURE_RATE=0.3
DEPENDENCY_LATENCY_MS=300

# ─── Read model ─────────────────────────────────────────────────────────────
MATVIEW_REFRESH_INTERVAL_S=10.0
